// blocks whose texture has a different name (waxed, infested, torches)
// <name> <shape> <textures...>  full-block face order: up down north south east west
// name[prop=a|b] matches every state with those property values; the most specific match wins
redstone_torch[lit=true] torch redstone_torch
redstone_torch[lit=false] torch redstone_torch_off
redstone_wall_torch[lit=true] wall_torch redstone_torch
redstone_wall_torch[lit=false] wall_torch redstone_torch_off
infested_stone full stone rotate=mirror
infested_cobblestone full cobblestone
infested_stone_bricks full stone_bricks
infested_mossy_stone_bricks full mossy_stone_bricks
infested_cracked_stone_bricks full cracked_stone_bricks
infested_chiseled_stone_bricks full chiseled_stone_bricks
waxed_copper_bars pane copper_bars
waxed_exposed_copper_bars pane exposed_copper_bars
waxed_weathered_copper_bars pane weathered_copper_bars
waxed_oxidized_copper_bars pane oxidized_copper_bars
waxed_copper_chain chain copper_chain
waxed_exposed_copper_chain chain exposed_copper_chain
waxed_weathered_copper_chain chain weathered_copper_chain
waxed_oxidized_copper_chain chain oxidized_copper_chain
waxed_copper_lantern lantern copper_lantern
waxed_exposed_copper_lantern lantern exposed_copper_lantern
waxed_weathered_copper_lantern lantern weathered_copper_lantern
waxed_oxidized_copper_lantern lantern oxidized_copper_lantern
waxed_oxidized_chiseled_copper full oxidized_chiseled_copper
waxed_weathered_chiseled_copper full weathered_chiseled_copper
waxed_exposed_chiseled_copper full exposed_chiseled_copper
waxed_chiseled_copper full chiseled_copper
waxed_copper_block full copper_block
waxed_weathered_copper full weathered_copper
waxed_exposed_copper full exposed_copper
waxed_oxidized_copper full oxidized_copper
waxed_oxidized_cut_copper full oxidized_cut_copper
waxed_weathered_cut_copper full weathered_cut_copper
waxed_exposed_cut_copper full exposed_cut_copper
waxed_cut_copper full cut_copper
waxed_copper_trapdoor trapdoor copper_trapdoor
waxed_exposed_copper_trapdoor trapdoor exposed_copper_trapdoor
waxed_oxidized_copper_trapdoor trapdoor oxidized_copper_trapdoor
